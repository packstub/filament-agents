{
    "name": "packstub/filament-agents",
    "description": "An in-panel AI assistant and an MCP server for Filament v5 panels, built on laravel/ai and laravel/mcp through packstub/agents: one tool list for both, the panel's own authorization, approve-in-chat writes, live tables and charts in answers, per-workspace budgets and an operator limits page.",
    "keywords": [
        "filament",
        "filament-plugin",
        "filament-panel",
        "filament-v5",
        "ai",
        "agents",
        "assistant",
        "chat",
        "mcp",
        "mcp-server",
        "laravel-ai",
        "laravel"
    ],
    "type": "library",
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/icaliman"
        }
    ],
    "authors": [
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "packstub/agents": "^1.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^13.3",
        "laravel/pint": "^1.13",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "orchestra/pest-plugin-testbench": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Packstub\\Agents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\Agents\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\Agents\\Filament\\FilamentAgentsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/packstub/filament-agents",
    "support": {
        "issues": "https://github.com/packstub/filament-agents/issues",
        "source": "https://github.com/packstub/filament-agents",
        "docs": "https://packstub.dev/docs/filament-agents"
    },
    "suggest": {
        "packstub/filament-tenancy": "Database-per-tenant panels: the MCP endpoint and the chat follow the workspace automatically."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
